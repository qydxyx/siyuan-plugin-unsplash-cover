{
  "name": "siyuan-plugin-unsplash-cover",
  "version": "0.1.2",
  "type": "module",
  "private": true,
  "description": "Unsplash cover images for SiYuan documents",
  "author": "qydxyx",
  "license": "MIT",
  "engines": {
    "node": "^20.19 || >=22.12"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite build --watch",
    "build": "run-s clean build:app",
    "build:app": "cross-env NODE_ENV=production vite build",
    "clean": "node ./scripts/clean.js",
    "check": "run-s check:types check:svelte",
    "check:types": "tsc --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js",
    "update-version": "node --no-warnings ./scripts/update_version.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.18.0",
    "cross-env": "^10.1.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.103.1",
    "siyuan": "^1.2.9",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^5.0.5"
  }
}
